{
  "name": "@simrs/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "echo 'no lint configured'",
    "test": "jest --passWithNoTests",
    "db:migrate": "tsx node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "db:rollback": "tsx node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "db:seed": "tsx node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts",
    "db:reset": "tsx node_modules/knex/bin/cli.js migrate:rollback --all --knexfile knexfile.ts && tsx node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts && tsx node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts"
  },
  "dependencies": {
    "@simrs/constants": "workspace:*",
    "@simrs/shared-types": "workspace:*",
    "@simrs/validators": "workspace:*",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dompurify": "^3.4.16",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "lz-string": "^1.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.15.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lz-string": "^1.5.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
