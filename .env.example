# ═══════════════════════════════════════
# SIMRS SaaS — Environment Variables
# Copy to .env and fill in values
# ═══════════════════════════════════════

# ── Database ──────────────────────────
POSTGRES_USER=simrs
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=simrs_db
DATABASE_URL=postgresql://simrs:<CHANGE_ME>@localhost:5432/simrs_db

# ── Redis ─────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=<CHANGE_ME>

# ── JWT ───────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=<CHANGE_ME_64_char_random>
JWT_REFRESH_SECRET=<CHANGE_ME_64_char_random>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Encryption ────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=<CHANGE_ME_64_char_random>

# ── MFA ───────────────────────────────
MFA_ISSUER=SIMRS SaaS

# ── Security ──────────────────────────
AUDIT_RETENTION_DAYS=1825
MAX_SESSIONS_PER_USER=5
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=100

# ── SATUSEHAT (optional) ─────────────
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_BASE_URL=https://api-satusehat.kemkes.go.id
SATUSEHAT_ORG_ID=

# ── BPJS (optional) ──────────────────
BPJS_CONSUMER_ID=
BPJS_CONSUMER_SECRET=
BPJS_BASE_URL=https://apijkn.bpjs-kesehatan.go.id
BPJS_MOCK_MODE=true

# ── Backup ────────────────────────────
BACKUP_DIR=./backups
USE_DOCKER_PG=false
POSTGRES_CONTAINER=simrs-postgres

# ── TTE / Tanda Tangan Elektronik ─────
# Provider: 'internal' | 'bsre' | 'vida' | 'privy'
TTE_PROVIDER=internal

# BSrE (BSSN) — gratis untuk instansi pemerintah
TTE_BSRE_URL=https://esign.bsre.bssn.go.id/api/v2
TTE_BSRE_USERNAME=
TTE_BSRE_PASSWORD=

# VIDA — PSrE swasta tersertifikasi
TTE_VIDA_URL=https://api.vida.id/v1
TTE_VIDA_API_KEY=
TTE_VIDA_API_SECRET=

# Privy — PSrE swasta tersertifikasi
TTE_PRIVY_URL=https://api.privy.id/v1
TTE_PRIVY_MERCHANT_KEY=
TTE_PRIVY_MERCHANT_TOKEN=

# ── SIRS Online & SIRANAP (Pelaporan Kemenkes) ──
# Konfigurasi di-manage via Admin Dashboard → SIRS Online / SIRANAP
# SIRS Online endpoint: https://sirs.kemkes.go.id/api
# SIRANAP endpoint: https://sirs.yankes.kemkes.go.id/sirsservice/ranap
# Kode RS, Username, Password didapat dari akun SIRS Online Kemenkes

# ── Email / SMTP ──────────────────────
# Configured via Platform Settings (admin panel)
# For development, use services like Mailtrap, Ethereal, or Gmail App Password
# Gmail: host=smtp.gmail.com, port=587, user=your@gmail.com, pass=app-password
# Mailtrap: host=sandbox.smtp.mailtrap.io, port=2525
# Settings managed in: Super Admin → Pengaturan Platform → Email

# ── Push Notifications (VAPID) ────────
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@simrs.online

# ── Server ────────────────────────────
PORT=4001
NODE_ENV=development

# ── Platform / SaaS ───────────────────
# Domain utama platform (production)
PLATFORM_DOMAIN=simrs.online
ADMIN_SUBDOMAIN=admin
# Set true di production untuk enable subdomain routing
ENABLE_SUBDOMAIN_ROUTING=false

# ── Frontend ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_PLATFORM_DOMAIN=simrs.online
NEXT_PUBLIC_ADMIN_SUBDOMAIN=admin
# Must match VAPID_PUBLIC_KEY above (for browser push subscription)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
