{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@simrs/shared-types": ["./packages/shared-types/src/index.ts"],
      "@simrs/validators": ["./packages/validators/src/index.ts"],
      "@simrs/constants": ["./packages/constants/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
